<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!-- Synthetic (written for this repository): a part that never writes a <time> of its own (after the hidden percussion
     part of Nielsen, Clarinet Concerto Op. 57). Flute: 3/4, 2/4 from m3. Cello: no <time> at all — it takes the flute's
     time signatures (m1 3/4, m3 2/4), as before. -->
