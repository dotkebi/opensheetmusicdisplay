<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!-- Synthetic sample after Couperin, Concerts royaux III, Prelude m5: voice 6's 8th rest at the time of voice 5's G#3
     (stem down), voice 6's notes above with upward stems, and voice 7's hidden half rest. -->
<score-partwise version="4.0">
  <part-list><score-part id="P1"><part-name>Bass</part-name></score-part></part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <key><fifths>3</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>F</sign><line>4</line></clef>
      </attributes>
      <note><pitch><step>G</step><alter>1</alter><octave>3</octave></pitch><duration>2</duration><voice>5</voice><type>quarter</type><stem>down</stem></note>
      <note><pitch><step>A</step><octave>3</octave></pitch><duration>1</duration><voice>5</voice><type>eighth</type><stem>down</stem><beam number="1">begin</beam></note>
      <note><pitch><step>F</step><alter>1</alter><octave>3</octave></pitch><duration>1</duration><voice>5</voice><type>eighth</type><stem>down</stem><beam number="1">end</beam></note>
      <note><pitch><step>B</step><octave>3</octave></pitch><duration>4</duration><voice>5</voice><type>half</type><stem>down</stem></note>
      <backup><duration>8</duration></backup>
      <note><rest/><duration>1</duration><voice>6</voice><type>eighth</type></note>
      <note><pitch><step>B</step><octave>3</octave></pitch><duration>1</duration><voice>6</voice><type>eighth</type><stem>up</stem></note>
      <note><pitch><step>A</step><octave>3</octave></pitch><duration>2</duration><voice>6</voice><type>quarter</type><stem>up</stem></note>
      <note><chord/><pitch><step>C</step><alter>1</alter><octave>4</octave></pitch><duration>2</duration><voice>6</voice><type>quarter</type><stem>up</stem></note>
      <note print-object="no"><rest/><duration>4</duration><voice>6</voice><type>half</type></note>
      <backup><duration>8</duration></backup>
      <note print-object="no"><rest/><duration>4</duration><voice>7</voice><type>half</type></note>
      <note print-object="no"><rest/><duration>4</duration><voice>7</voice><type>half</type></note>
    </measure>
  </part>
</score-partwise>
