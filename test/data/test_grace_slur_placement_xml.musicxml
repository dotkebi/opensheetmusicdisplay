<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!-- A slur from a grace note to its own main note keeps the placement written in the XML.
     m1 (Couperin, Concerts Royaux IV/5 Sarabande, m4): stem-down grace notes slurred below.
     m2: a stem-up grace note slurred above.
     m3: no placement, the arc stays opposite the grace note's stem (below a stem-up grace note). -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1"><part-name>Piano</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>4</fifths></key>
        <time><beats>3</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note>
        <grace slash="no"/>
        <pitch><step>F</step><alter>1</alter><octave>4</octave></pitch>
        <voice>1</voice><type>eighth</type><stem>down</stem>
        <notations><slur type="start" number="1" placement="below"/></notations>
      </note>
      <note>
        <pitch><step>G</step><alter>1</alter><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type><stem>down</stem>
        <notations><slur type="stop" number="1"/></notations>
      </note>
      <note>
        <grace slash="no"/>
        <pitch><step>F</step><alter>1</alter><octave>4</octave></pitch>
        <voice>1</voice><type>eighth</type><stem>down</stem>
        <notations><slur type="start" number="1" placement="below"/></notations>
      </note>
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type><stem>down</stem>
        <notations><slur type="stop" number="1"/></notations>
      </note>
      <note>
        <rest/><duration>1</duration><voice>1</voice><type>quarter</type>
      </note>
    </measure>
    <measure number="2">
      <note>
        <grace slash="no"/>
        <pitch><step>A</step><octave>4</octave></pitch>
        <voice>1</voice><type>eighth</type><stem>up</stem>
        <notations><slur type="start" number="1" placement="above"/></notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>3</duration><voice>1</voice><type>half</type><dot/><stem>up</stem>
        <notations><slur type="stop" number="1"/></notations>
      </note>
    </measure>
    <measure number="3">
      <note>
        <grace slash="no"/>
        <pitch><step>A</step><octave>4</octave></pitch>
        <voice>1</voice><type>eighth</type><stem>up</stem>
        <notations><slur type="start" number="1"/></notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>3</duration><voice>1</voice><type>half</type><dot/><stem>up</stem>
        <notations><slur type="stop" number="1"/></notations>
      </note>
      <barline location="right"><bar-style>light-heavy</bar-style></barline>
    </measure>
  </part>
</score-partwise>
