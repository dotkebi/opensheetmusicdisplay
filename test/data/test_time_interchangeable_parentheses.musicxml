<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic (written for this repository): a viola and a piano in 4/4 with 12/8 interchangeable in parentheses
     (<time-relation>parentheses</time-relation>), printed "(12/8) 4/4" as in Bowen's public-domain Viola Sonata No. 2
     m477; the left hand has eighth triplets against the right hand's quarters. -->
